# Public URL of the deployed site (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: use Cal.com instead of the built-in booking calendar, e.g. "nikki-mamanduri/30min"
NEXT_PUBLIC_CAL_LINK=

# Optional: email notifications for bookings, contact messages and newsletter sign-ups (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=

# Public URL of the deployed site (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: email notifications for bookings, contact messages and newsletter sign-ups (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=

# Site chat assistant (optional). Without it the assistant answers from built-in site content.
# Create a key at https://vercel.com/ai-gateway (not needed when deployed on Vercel with AI Gateway enabled).
AI_GATEWAY_API_KEY=
